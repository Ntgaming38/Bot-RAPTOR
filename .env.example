# === BẮT BUỘC ===
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# === TÙY CHỌN CƠ BẢN ===
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
AUTO_ROLE_ID=
LOG_CHANNEL_ID=
BANNED_WORDS= dm,cc,xxx
KEEP_ALIVE=true
PORT=3000
EMBED_COLOR=#5865F2

# === NHẠC (discord-player + YouTube) ===
# Cookie YouTube giúp phát nhạc ổn định hơn. Để trống vẫn chạy (SoundCloud/link trực tiếp).
# Lấy: đăng nhập youtube.com → F12 → Application → Cookies → copy nguyên chuỗi cookie.
YOUTUBE_COOKIE=
MAX_VOLUME=100

# === LEVEL / XP ===
LEVEL_UP_MESSAGE=true
XP_MIN=15
XP_MAX=25
XP_COOLDOWN=60

# === CHÀO MỪNG KIỂU MẪU (như hình) ===
# Tiêu đề embed, VD: By GIN.G_VN — để trống = By <tên server>
WELCOME_TITLE=
# ID các kênh để tag trong lời chào (chuột phải kênh → Copy Channel ID)
WELCOME_ROLE_CHANNEL_ID=
WELCOME_RULES_CHANNEL_ID=
WELCOME_ANNOUNCE_CHANNEL_ID=
WELCOME_CHAT_CHANNEL_ID=
# Ảnh góc phải — để trống = icon server. VD: link logo sever
WELCOME_IMAGE_URL=
# Reactions tự thả dưới lời chào (tối đa 5, cách nhau dấu phẩy)
WELCOME_REACTIONS=🔥,✅
# Màu viền trái (hình là hồng)
WELCOME_COLOR=#FF4D9D

# === TICKET ===
# ID category để tạo kênh ticket (để trống = tạo ở đầu server)
TICKET_CATEGORY_ID=
# ID role staff có thể xem mọi ticket (để trống = chỉ admin + chủ ticket)
TICKET_STAFF_ROLE_ID=
# Ảnh góc phải của panel Mở Ticket (link ảnh, để trống = không có ảnh)
TICKET_PANEL_IMAGE_URL=

# === DATABASE (giữ XP/giveaway/ticket khi Render restart) ===
# Để trống = dùng file JSON trong data/. Muốn giữ vĩnh viễn: tạo free ở mongodb.com/atlas → Database → Connect → copy chuỗi.
# VD: MONGODB_URI=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/bot-raptor?retryWrites=true&w=majority
MONGODB_URI=
